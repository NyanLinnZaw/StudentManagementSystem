{
  "info": {
    "name": "Student Management System API",
    "description": "Complete Spring Boot Student Management System API collection.\n\n1. Run Login (or Register) first.\n2. Token is saved automatically from the login/register response.\n3. Create Classroom → Subject → Student → Score in that order.\n4. Use returned IDs in path variables (or update collection variables).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "classroomId",
      "value": "1"
    },
    {
      "key": "subjectId",
      "value": "1"
    },
    {
      "key": "studentId",
      "value": "1"
    },
    {
      "key": "scoreId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login with seeded admin. Saves JWT to collection variable `token`."
          }
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"teacher1\",\n  \"password\": \"pass123\",\n  \"email\": \"teacher1@school.com\",\n  \"role\": \"TEACHER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user. Role: ADMIN | TEACHER | STUDENT (default STUDENT)."
          }
        }
      ]
    },
    {
      "name": "Classroom",
      "item": [
        {
          "name": "Create Classroom",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set('classroomId', String(json.id));",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classroomCode\": \"C001\",\n  \"classroomName\": \"Grade 10A\",\n  \"capacity\": 40\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classrooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classrooms"]
            }
          }
        },
        {
          "name": "Update Classroom",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"classroomCode\": \"C001\",\n  \"classroomName\": \"Grade 10A Updated\",\n  \"capacity\": 45\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classrooms/{{classroomId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classrooms", "{{classroomId}}"]
            }
          }
        },
        {
          "name": "Get Classroom By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/classrooms/{{classroomId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classrooms", "{{classroomId}}"]
            }
          }
        },
        {
          "name": "Get Classrooms",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/classrooms?keyword=&page=0&size=10&sortBy=id&sortDir=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classrooms"],
              "query": [
                { "key": "keyword", "value": "" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sortBy", "value": "id" },
                { "key": "sortDir", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Delete Classroom",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/classrooms/{{classroomId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classrooms", "{{classroomId}}"]
            },
            "description": "Soft-delete classroom. Prefer running this last in a test flow."
          }
        }
      ]
    },
